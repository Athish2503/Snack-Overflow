# Environment variables for Snack Overflow

# API Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/snack_overflow?schema=public"

# Authentication / Session
SESSION_SECRET="development-secret-must-be-at-least-32-chars-long"
COOKIE_SECRET="development-cookie-secret-min-32-chars"

# Frontend Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Docker Compose Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=snackoverflow
POSTGRES_PORT=5432
WEB_PORT=3000
