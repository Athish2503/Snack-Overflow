{
  "name": "snack-overflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev": "npm --workspace=apps/api run dev",
    "build": "npm run --workspaces --if-present build",
    "build:api": "npm --workspace=apps/api run prisma:generate && npm --workspace=apps/api run build",
    "build:web": "npm --workspace=apps/web run build",
    "start:api": "npm --workspace=apps/api run start",
    "start:web": "npm --workspace=apps/web run start",
    "test": "npm run --workspaces --if-present test",
    "lint": "npm run --workspaces --if-present lint",
    "type-check": "npm run --workspaces --if-present type-check",
    "db:migrate": "npm --workspace=apps/api run prisma:migrate",
    "db:migrate:deploy": "npm --workspace=apps/api run prisma:migrate:deploy",
    "db:seed": "npm --workspace=apps/api run prisma:seed",
    "prisma:migrate": "npm --workspace=apps/api run prisma:migrate",
    "prisma:seed": "npm --workspace=apps/api run prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
